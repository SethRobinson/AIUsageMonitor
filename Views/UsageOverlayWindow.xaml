<Window x:Class="AIUsageMonitor.Views.UsageOverlayWindow"
        x:Name="OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Seth's AI Usage Monitor"
        Width="900"
        Height="760"
        MinWidth="320"
        MinHeight="56"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        PreviewKeyDown="WindowOnPreviewKeyDown"
        PreviewMouseLeftButtonDown="WindowOnPreviewMouseLeftButtonDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="FullOnlyElementStyle" TargetType="{x:Type FrameworkElement}">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="Compact">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="Mini">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CompactOnlyElementStyle" TargetType="{x:Type FrameworkElement}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="Compact">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CompactButtonsElementStyle" TargetType="{x:Type FrameworkElement}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="Compact" />
                        <Condition Binding="{Binding ShowCompactButtons, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MiniOnlyElementStyle" TargetType="{x:Type FrameworkElement}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="Mini">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NotMiniElementStyle" TargetType="{x:Type FrameworkElement}">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="Mini">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="OverlayChromeStyle" TargetType="{x:Type Border}">
            <Setter Property="Margin" Value="18" />
            <Setter Property="Padding" Value="24" />
            <Setter Property="Background" Value="#FF15171D" />
            <Setter Property="BorderBrush" Value="#303540" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="Compact">
                    <Setter Property="Margin" Value="4" />
                    <Setter Property="Padding" Value="10" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="Mini">
                    <Setter Property="Margin" Value="4" />
                    <Setter Property="Padding" Value="6" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ProviderCardStyle" TargetType="{x:Type Border}">
            <Setter Property="Margin" Value="5" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="MinHeight" Value="190" />
            <Setter Property="Background" Value="#FF1D2028" />
            <Setter Property="BorderBrush" Value="#303641" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="Compact">
                    <Setter Property="Margin" Value="4" />
                    <Setter Property="Padding" Value="8" />
                    <Setter Property="MinHeight" Value="92" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="Mini">
                    <Setter Property="Margin" Value="3,2" />
                    <Setter Property="Padding" Value="6,4" />
                    <Setter Property="MinHeight" Value="0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Foreground" Value="#E5E7EB" />
            <Setter Property="Background" Value="#232733" />
            <Setter Property="BorderBrush" Value="#343A46" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2F3542" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#3B4252" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="Compact">
                    <Setter Property="Width" Value="30" />
                    <Setter Property="Height" Value="30" />
                    <Setter Property="Margin" Value="5,0,0,0" />
                    <Setter Property="FontSize" Value="14" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="Mini">
                    <Setter Property="Width" Value="28" />
                    <Setter Property="Height" Value="28" />
                    <Setter Property="Margin" Value="4,0,0,0" />
                    <Setter Property="FontSize" Value="13" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="UsageProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="9" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Background" Value="#4A5361" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="PART_Track" ClipToBounds="True">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="5" />
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="5" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="ResizeThumbTemplate" TargetType="Thumb">
            <Grid Background="#01000000">
                <Path Data="M 23,7 L 7,23 M 23,13 L 13,23 M 23,19 L 19,23"
                      Stroke="#8B93A1"
                      StrokeThickness="1.6"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round" />
            </Grid>
        </ControlTemplate>

        <Style x:Key="WindowResizeThumbStyle" TargetType="{x:Type Thumb}">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Cursor" Value="SizeNWSE" />
            <Setter Property="ToolTip" Value="Resize" />
            <Setter Property="Template" Value="{StaticResource ResizeThumbTemplate}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="Mini">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InlineMiniResizeThumbStyle" TargetType="{x:Type Thumb}">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Cursor" Value="SizeNWSE" />
            <Setter Property="ToolTip" Value="Resize" />
            <Setter Property="Template" Value="{StaticResource ResizeThumbTemplate}" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="Mini">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid x:Name="WindowRoot"
          Background="#01000000">
        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Show Seth's AI Usage Monitor"
                          Click="ShowMenuItemOnClick" />
                <MenuItem Header="Refresh Now"
                          Click="RefreshMenuItemOnClick" />
                <MenuItem Header="Settings"
                          Click="SettingsMenuItemOnClick" />
                <MenuItem Header="Logs"
                          Click="LogsMenuItemOnClick" />
                <Separator />
                <MenuItem Header="Exit"
                          Click="ExitMenuItemOnClick" />
            </ContextMenu>
        </Grid.ContextMenu>

        <Grid x:Name="OverlayScaleHost">
            <Grid.LayoutTransform>
                <ScaleTransform ScaleX="{Binding UiScale, ElementName=OverlayWindow}"
                                ScaleY="{Binding UiScale, ElementName=OverlayWindow}" />
            </Grid.LayoutTransform>

            <Border x:Name="ChromeBorder"
                    Style="{StaticResource OverlayChromeStyle}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30"
                                  Direction="270"
                                  ShadowDepth="8"
                                  Opacity="0.42"
                                  Color="#000000" />
            </Border.Effect>

            <Grid>
                <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      Style="{StaticResource FullOnlyElementStyle}"
                      MouseLeftButtonDown="HeaderOnMouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Seth's AI Usage Monitor"
                                       Foreground="#F9FAFB"
                                       FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="FontSize" Value="28" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="Compact">
                                                <Setter Property="FontSize" Value="22" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Border Margin="12,3,0,0"
                                    Padding="8,3"
                                    VerticalAlignment="Center"
                                    Background="#232733"
                                    BorderBrush="#343A46"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Style="{StaticResource FullOnlyElementStyle}">
                                <TextBlock Text="{Binding AppVersionText}"
                                           Foreground="#A8AFBA"
                                           FontSize="12"
                                           FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding GeneratedAtText}"
                                   Margin="0,4,0,0"
                                   Foreground="#A8AFBA"
                                   FontSize="13" />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Top">
                        <Button Content="⚙"
                                Style="{StaticResource IconButtonStyle}"
                                ToolTip="Settings"
                                Click="SettingsButtonOnClick" />
                        <Button Content="↻"
                                Style="{StaticResource IconButtonStyle}"
                                ToolTip="Refresh now"
                                Click="ReloadButtonOnClick" />
                        <Button Content="!"
                                Style="{StaticResource IconButtonStyle}"
                                ToolTip="Logs"
                                Click="LogsButtonOnClick" />
                        <Button Content="×"
                                Style="{StaticResource IconButtonStyle}"
                                ToolTip="Hide"
                                Click="HideButtonOnClick" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1"
                        Padding="12,10"
                        Background="#2B1B20"
                        BorderBrush="#7F1D1D"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Border.Style>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="Margin" Value="0,18,0,0" />
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasError}" Value="True" />
                                        <Condition Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="Full" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasError}" Value="True" />
                                        <Condition Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="Compact" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Margin" Value="0,12,0,0" />
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="#FCA5A5"
                               FontSize="13"
                               TextWrapping="Wrap" />
                </Border>

                <ScrollViewer x:Name="ProvidersScrollViewer"
                              Grid.Row="2"
                              HorizontalScrollBarVisibility="Disabled">
                    <ScrollViewer.Style>
                        <Style TargetType="{x:Type ScrollViewer}">
                            <Setter Property="Visibility" Value="Visible" />
                            <Setter Property="Margin" Value="0,18,0,0" />
                            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasProviders}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="Compact">
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="Mini">
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <ItemsControl x:Name="ProvidersList"
                                  Width="{Binding ProvidersListWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                                  HorizontalAlignment="Left"
                                  ItemsSource="{Binding Providers}"
                                  SizeChanged="ProvidersListOnSizeChanged">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel IsItemsHost="True"
                                           ItemWidth="{Binding CardSlotWidth, RelativeSource={RelativeSource AncestorType=Window}}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ProviderCardStyle}">
                                    <Grid>
                                        <Grid Style="{StaticResource FullOnlyElementStyle}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Border Width="4"
                                                        Height="28"
                                                        Margin="0,0,12,0"
                                                        Background="{Binding AccentBrush}"
                                                        CornerRadius="2" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Name}"
                                                           Margin="0,0,12,0"
                                                           Foreground="#F3F4F6"
                                                           FontSize="18"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="2"
                                                            HorizontalAlignment="Right">
                                                    <Border Padding="9,4"
                                                            Background="{Binding OverallStatusBackground}"
                                                            CornerRadius="8">
                                                        <TextBlock Text="{Binding OverallStatusLabel}"
                                                                   Foreground="{Binding OverallStatusBrush}"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold" />
                                                    </Border>
                                                    <TextBlock Margin="0,6,0,0"
                                                               Text="{Binding CheckedText}"
                                                               Foreground="#8B93A1"
                                                               FontSize="11"
                                                               HorizontalAlignment="Right" />
                                                </StackPanel>
                                            </Grid>

                                            <StackPanel Grid.Row="1"
                                                        Margin="0,18,0,0">
                                                <TextBlock Text="{Binding StatusMessage}"
                                                           Foreground="#A8AFBA"
                                                           FontSize="13"
                                                           TextWrapping="Wrap"
                                                           Visibility="{Binding IsUnavailable, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                                <ItemsControl ItemsSource="{Binding Windows}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Margin="0,0,0,18">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding Title}"
                                                                               Foreground="#D6DAE1"
                                                                               FontSize="13"
                                                                               FontWeight="SemiBold" />
                                                                    <TextBlock Grid.Column="1"
                                                                               Text="{Binding RemainingText}"
                                                                               Foreground="#F9FAFB"
                                                                               FontSize="13"
                                                                               FontWeight="SemiBold" />
                                                                </Grid>

                                                                <ProgressBar Margin="0,8,0,0"
                                                                             Style="{StaticResource UsageProgressBarStyle}"
                                                                             Value="{Binding RemainingPercent, Mode=OneWay}"
                                                                             Foreground="{Binding ProgressBrush}" />

                                                                <Grid Margin="0,8,0,0">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding LimitText}"
                                                                               Foreground="#A8AFBA"
                                                                               FontSize="12" />
                                                                    <StackPanel Grid.Column="1"
                                                                                Orientation="Horizontal"
                                                                                HorizontalAlignment="Right">
                                                                        <TextBlock Text="{Binding ResetRelativeText}"
                                                                                   Foreground="{Binding ResetRelativeBrush}"
                                                                                   FontSize="12"
                                                                                   FontWeight="SemiBold" />
                                                                        <TextBlock Text="{Binding ResetText}"
                                                                                   Margin="10,0,0,0"
                                                                                   Foreground="#A8AFBA"
                                                                                   FontSize="12" />
                                                                    </StackPanel>
                                                                </Grid>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Grid>

                                        <StackPanel Style="{StaticResource CompactOnlyElementStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding SummaryText}"
                                                           Foreground="#F3F4F6"
                                                           FontSize="15"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" />
                                                <Border Grid.Column="1"
                                                        Margin="10,0,0,0"
                                                        Padding="7,3"
                                                        Background="{Binding OverallStatusBackground}"
                                                        CornerRadius="7">
                                                    <TextBlock Text="{Binding OverallStatusLabel}"
                                                               Foreground="{Binding OverallStatusBrush}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold" />
                                                </Border>
                                            </Grid>

                                            <ItemsControl Margin="0,8,0,0"
                                                          ItemsSource="{Binding Windows}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,5,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Title}"
                                                                       Foreground="#A8AFBA"
                                                                       FontSize="11"
                                                                       MaxWidth="130"
                                                                       MinWidth="58"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <ProgressBar Grid.Column="1"
                                                                         Margin="8,0,8,0"
                                                                         Height="6"
                                                                         VerticalAlignment="Center"
                                                                         Style="{StaticResource UsageProgressBarStyle}"
                                                                         Value="{Binding RemainingPercent, Mode=OneWay}"
                                                                         Foreground="{Binding ProgressBrush}" />
                                                            <TextBlock Grid.Column="2"
                                                                       Margin="8,0,0,0"
                                                                       Text="{Binding ResetRelativeText}"
                                                                       Foreground="{Binding ResetRelativeBrush}"
                                                                       FontSize="11"
                                                                       FontWeight="SemiBold" />
                                                            <TextBlock Grid.Column="3"
                                                                       Margin="8,0,0,0"
                                                                       Text="{Binding RemainingText}"
                                                                       Foreground="#D6DAE1"
                                                                       FontSize="11"
                                                                       FontWeight="SemiBold" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <StackPanel Style="{StaticResource MiniOnlyElementStyle}">
                                            <TextBlock Text="{Binding SummaryText}"
                                                       Foreground="#F3F4F6"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <ProgressBar Margin="0,4,0,0"
                                                         Height="4"
                                                         Style="{StaticResource UsageProgressBarStyle}"
                                                         Value="{Binding PrimaryRemainingPercent, Mode=OneWay}"
                                                         Foreground="{Binding SummaryProgressBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Border Grid.Row="2"
                        Background="#1D2028"
                        BorderBrush="#303641"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Border.Style>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Setter Property="Margin" Value="0,18,0,0" />
                            <Setter Property="Padding" Value="16" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasProviders}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="Compact">
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="Padding" Value="12" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="Mini">
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="Padding" Value="8,6" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="No providers enabled. Open Settings to enable one."
                               Foreground="#A8AFBA"
                               FontSize="13"
                               TextWrapping="Wrap" />
                </Border>

                <Grid Grid.Row="3"
                      Margin="0,10,0,0"
                      Style="{StaticResource FullOnlyElementStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding SourcePathText}"
                               Foreground="#6B7280"
                               FontSize="11"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1"
                               Margin="16,0,0,0"
                               Text="{Binding LogSummaryText}"
                               Foreground="#6B7280"
                               FontSize="11" />
                    <TextBlock Grid.Column="2"
                               Margin="16,0,0,0"
                               Text="{Binding AutoRefreshText}"
                               Foreground="#6B7280"
                               FontSize="11" />
                </Grid>
                </Grid>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Style="{StaticResource CompactButtonsElementStyle}">
                    <Button Content="⚙"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="Settings"
                            Click="SettingsButtonOnClick" />
                    <Button Content="↻"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="Refresh now"
                            Click="ReloadButtonOnClick" />
                    <Button Content="!"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="Logs"
                            Click="LogsButtonOnClick" />
                    <Button Content="×"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="Hide"
                            Click="HideButtonOnClick" />
                </StackPanel>

                <Thumb HorizontalAlignment="Right"
                       VerticalAlignment="Bottom"
                       Style="{StaticResource InlineMiniResizeThumbStyle}"
                       DragStarted="ResizeThumbOnDragStarted"
                       DragDelta="ResizeThumbOnDragDelta"
                       DragCompleted="ResizeThumbOnDragCompleted" />
            </Grid>
            </Border>
        </Grid>

        <Thumb Style="{StaticResource WindowResizeThumbStyle}"
               HorizontalAlignment="Right"
               VerticalAlignment="Bottom"
               DragStarted="ResizeThumbOnDragStarted"
               DragDelta="ResizeThumbOnDragDelta"
               DragCompleted="ResizeThumbOnDragCompleted" />
    </Grid>
</Window>
