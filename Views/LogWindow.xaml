<Window x:Class="AIUsageMonitor.Views.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Seth's AI Usage Monitor Logs"
        Width="760"
        Height="460"
        WindowStartupLocation="CenterOwner"
        Background="#15171D"
        Foreground="#F9FAFB"
        Icon="/Assets/AppIcon.ico"
        ShowInTaskbar="False">
    <Border Padding="18"
            Background="#15171D">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Logs"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="#F9FAFB" />
                <Button Grid.Column="1"
                        MinWidth="112"
                        Height="32"
                        Margin="0,0,8,0"
                        Padding="14,0"
                        Content="Copy Selected"
                        Click="CopySelectedButtonOnClick" />
                <Button Grid.Column="2"
                        MinWidth="92"
                        Height="32"
                        Margin="0,0,8,0"
                        Padding="14,0"
                        Content="Copy All"
                        Click="CopyAllButtonOnClick" />
                <Button Grid.Column="3"
                        MinWidth="92"
                        Height="32"
                        Padding="14,0"
                        Content="Clear"
                        Click="ClearButtonOnClick" />
            </Grid>

            <DataGrid x:Name="LogsDataGrid"
                      Grid.Row="1"
                      Margin="0,16,0,14"
                      ItemsSource="{Binding}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      SelectionMode="Extended"
                      SelectionUnit="FullRow"
                      ClipboardCopyMode="IncludeHeader"
                      GridLinesVisibility="Horizontal"
                      Background="#1D2028"
                      Foreground="#F9FAFB"
                      BorderBrush="#343A46"
                      RowBackground="#1D2028"
                      AlternatingRowBackground="#222631">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#252A33" />
                        <Setter Property="Foreground" Value="#F9FAFB" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Padding" Value="10,7" />
                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Setter Property="BorderBrush" Value="#343A46" />
                        <Setter Property="BorderThickness" Value="0,0,1,1" />
                        <Setter Property="SeparatorBrush" Value="#343A46" />
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Time"
                                        Width="150"
                                        Binding="{Binding Timestamp, StringFormat={}{0:MMM d h:mm:ss tt}}" />
                    <DataGridTextColumn Header="Level"
                                        Width="80"
                                        Binding="{Binding Level}" />
                    <DataGridTextColumn Header="Source"
                                        Width="120"
                                        Binding="{Binding Source}" />
                    <DataGridTextColumn Header="Message"
                                        Width="*"
                                        Binding="{Binding Message}" />
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock x:Name="LogPathTextBlock"
                       Grid.Row="2"
                       Foreground="#8B93A1"
                       FontSize="12"
                       TextTrimming="CharacterEllipsis" />
        </Grid>
    </Border>
</Window>
