<Window x:Class="AIUsageMonitor.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Seth's AI Usage Monitor Settings"
        Width="540"
        Height="700"
        MinWidth="500"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#15171D"
        Foreground="#F9FAFB"
        Icon="/Assets/AppIcon.ico"
        ShowInTaskbar="False">
    <Border Padding="22"
            Background="#15171D">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="Settings"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="#F9FAFB" />

            <ScrollViewer Grid.Row="1"
                          Margin="0,22,0,16"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <StackPanel>
                        <TextBlock Text="Update interval"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#D6DAE1" />
                        <DockPanel Margin="0,8,0,0">
                            <TextBox x:Name="UpdateIntervalTextBox"
                                     Width="96"
                                     Height="34"
                                     Padding="8,5"
                                     VerticalContentAlignment="Center"
                                     Background="#1D2028"
                                     BorderBrush="#343A46"
                                     Foreground="#F9FAFB"
                                     CaretBrush="#F9FAFB"
                                     FontSize="14" />
                            <TextBlock Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       Text="minutes"
                                       Foreground="#A8AFBA"
                                       FontSize="13" />
                        </DockPanel>
                        <TextBlock Margin="0,8,0,0"
                                   Text="Default is 20. Manual refresh still runs immediately."
                                   Foreground="#8B93A1"
                                   FontSize="12" />

                        <StackPanel Margin="0,18,0,0">
                            <TextBlock Text="UI scale"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#D6DAE1" />
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="UiScaleSlider"
                                        Minimum="80"
                                        Maximum="150"
                                        TickFrequency="5"
                                        IsSnapToTickEnabled="True"
                                        SmallChange="5"
                                        LargeChange="10"
                                        VerticalAlignment="Center"
                                        ValueChanged="UiScaleSliderOnValueChanged" />
                                <TextBlock x:Name="UiScaleValueTextBlock"
                                           Grid.Column="1"
                                           Width="56"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center"
                                           TextAlignment="Right"
                                           Foreground="#F9FAFB"
                                           FontSize="13"
                                           FontWeight="SemiBold" />
                            </Grid>
                            <TextBlock Margin="0,8,0,0"
                                       Text="Scales the overlay text, controls, spacing, and progress bars."
                                       Foreground="#8B93A1"
                                       FontSize="12" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Margin="0,22,0,0">
                        <TextBlock Text="Providers"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#D6DAE1" />
                        <TextBlock Margin="0,8,0,0"
                                   Text="Enabled providers appear in the overlay and are included in refreshes."
                                   Foreground="#8B93A1"
                                   FontSize="12" />
                        <Border Margin="0,10,0,0"
                                Background="#1A1D25"
                                BorderBrush="#303641"
                                BorderThickness="1"
                                CornerRadius="8">
                            <ScrollViewer MaxHeight="380"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <Border Padding="12"
                                            BorderBrush="#2A303A"
                                            BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <CheckBox x:Name="AnthropicProviderEnabledCheckBox"
                                                          Content="Anthropic"
                                                          Foreground="#D6DAE1"
                                                          FontSize="13"
                                                          FontWeight="SemiBold" />
                                                <TextBlock Margin="24,4,0,0"
                                                           Text="Claude Code local OAuth and status-line quota data."
                                                           Foreground="#8B93A1"
                                                           FontSize="12"
                                                           TextWrapping="Wrap" />
                                                <CheckBox x:Name="ClaudeStatusExporterCheckBox"
                                                          Margin="24,10,0,0"
                                                          Content="Install Claude Code status exporter automatically"
                                                          Foreground="#D6DAE1"
                                                          FontSize="12" />
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Width="82"
                                                    Height="30"
                                                    Margin="12,0,0,0"
                                                    VerticalAlignment="Top"
                                                    Content="Setup"
                                                    Tag="Anthropic"
                                                    Click="ProviderSetupButtonOnClick" />
                                        </Grid>
                                    </Border>

                                    <Border Padding="12"
                                            BorderBrush="#2A303A"
                                            BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <CheckBox x:Name="AntigravityProviderEnabledCheckBox"
                                                          Content="Antigravity"
                                                          Foreground="#D6DAE1"
                                                          FontSize="13"
                                                          FontWeight="SemiBold" />
                                                <TextBlock Margin="24,4,0,0"
                                                           Text="Local Antigravity language-server model quota."
                                                           Foreground="#8B93A1"
                                                           FontSize="12"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Width="82"
                                                    Height="30"
                                                    Margin="12,0,0,0"
                                                    VerticalAlignment="Top"
                                                    Content="Setup"
                                                    Tag="Antigravity"
                                                    Click="ProviderSetupButtonOnClick" />
                                        </Grid>
                                    </Border>

                                    <Border Padding="12"
                                            BorderBrush="#2A303A"
                                            BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <CheckBox x:Name="OpenAiProviderEnabledCheckBox"
                                                          Content="OpenAI"
                                                          Foreground="#D6DAE1"
                                                          FontSize="13"
                                                          FontWeight="SemiBold" />
                                                <TextBlock Margin="24,4,0,0"
                                                           Text="Codex local session logs and CLI quota refreshes."
                                                           Foreground="#8B93A1"
                                                           FontSize="12"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Width="82"
                                                    Height="30"
                                                    Margin="12,0,0,0"
                                                    VerticalAlignment="Top"
                                                    Content="Setup"
                                                    Tag="OpenAI"
                                                    Click="ProviderSetupButtonOnClick" />
                                        </Grid>
                                    </Border>

                                    <Border Padding="12"
                                            BorderBrush="#2A303A"
                                            BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <CheckBox x:Name="GeminiProviderEnabledCheckBox"
                                                          Content="Gemini"
                                                          Foreground="#D6DAE1"
                                                          FontSize="13"
                                                          FontWeight="SemiBold" />
                                                <TextBlock Margin="24,4,0,0"
                                                           Text="Gemini CLI credentials, Code Assist quota, quota status export, and local session data."
                                                           Foreground="#8B93A1"
                                                           FontSize="12"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Width="82"
                                                    Height="30"
                                                    Margin="12,0,0,0"
                                                    VerticalAlignment="Top"
                                                    Content="Setup"
                                                    Tag="Gemini"
                                                    Click="ProviderSetupButtonOnClick" />
                                        </Grid>
                                    </Border>

                                    <Border Padding="12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <CheckBox x:Name="CursorProviderEnabledCheckBox"
                                                          Content="Cursor"
                                                          Foreground="#D6DAE1"
                                                          FontSize="13"
                                                          FontWeight="SemiBold" />
                                                <TextBlock Margin="24,4,0,0"
                                                           Text="Personal dashboard login or Teams Admin API spend data."
                                                           Foreground="#8B93A1"
                                                           FontSize="12"
                                                           TextWrapping="Wrap" />
                                                <TextBlock x:Name="CursorModeSummaryTextBlock"
                                                           Margin="24,8,0,0"
                                                           Foreground="#A8AFBA"
                                                           FontSize="12"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Width="82"
                                                    Height="30"
                                                    Margin="12,0,0,0"
                                                    VerticalAlignment="Top"
                                                    Content="Setup"
                                                    Click="CursorSetupButtonOnClick" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>

                    <StackPanel Margin="0,22,0,0">
                        <CheckBox x:Name="AutoRunAtLoginCheckBox"
                                  Content="Auto run at login"
                                  Foreground="#D6DAE1"
                                  FontSize="13" />
                    </StackPanel>

                    <TextBlock x:Name="ValidationTextBlock"
                               Margin="0,16,0,0"
                               TextWrapping="Wrap"
                               Foreground="#FCA5A5"
                               FontSize="12" />
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Width="92"
                        Height="34"
                        HorizontalAlignment="Left"
                        Content="About"
                        Click="AboutButtonOnClick" />

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Width="92"
                            Height="34"
                            Margin="0,0,8,0"
                            Content="Cancel"
                            Click="CancelButtonOnClick" />
                    <Button Width="92"
                            Height="34"
                            Content="Save"
                            Click="SaveButtonOnClick" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
