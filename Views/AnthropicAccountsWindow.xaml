<Window x:Class="AIUsageMonitor.Views.AnthropicAccountsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Claude Accounts"
        Width="560"
        Height="520"
        MinWidth="520"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#15171D"
        Foreground="#F9FAFB"
        Icon="/Assets/AppIcon.ico"
        ShowInTaskbar="False">
    <Border Padding="22"
            Background="#15171D">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="Claude Accounts"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="#F9FAFB" />

            <StackPanel Grid.Row="1">
                <TextBlock Margin="0,10,0,0"
                           TextWrapping="Wrap"
                           Foreground="#8B93A1"
                           FontSize="12"
                           Text="Each account gets its own card in the overlay. Adding an account opens a terminal where you log in with the official claude CLI into a separate config folder; adding an account never changes which account the CLI itself uses. Only 'Switch CLI to this' does that, and the login you switch away from is kept as its own entry so you can switch back." />
                <TextBlock x:Name="ActiveAccountTextBlock"
                           Margin="0,10,0,0"
                           TextWrapping="Wrap"
                           Foreground="#D6DAE1"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Text="Active claude CLI account: checking..." />
            </StackPanel>

            <ScrollViewer Grid.Row="2"
                          Margin="0,14,0,0"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="AccountsPanel" />
            </ScrollViewer>

            <StackPanel Grid.Row="3"
                        Margin="0,12,0,0">
                <TextBlock x:Name="StatusTextBlock"
                           TextWrapping="Wrap"
                           Foreground="#A8AFBA"
                           FontSize="12" />
            </StackPanel>

            <Grid Grid.Row="4"
                  Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Button x:Name="AddAccountButton"
                            Width="120"
                            Height="34"
                            Content="Add account"
                            Click="AddAccountButtonOnClick" />
                    <Button x:Name="CancelLoginButton"
                            Width="120"
                            Height="34"
                            Margin="8,0,0,0"
                            Content="Cancel login"
                            Visibility="Collapsed"
                            Click="CancelLoginButtonOnClick" />
                </StackPanel>

                <Button Grid.Column="1"
                        Width="92"
                        Height="34"
                        Content="Close"
                        Click="CloseButtonOnClick" />
            </Grid>
        </Grid>
    </Border>
</Window>
