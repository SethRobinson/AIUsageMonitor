<Window x:Class="AIUsageMonitor.Views.AnthropicApiCreditsSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Anthropic API Credits Setup"
        Width="1100"
        Height="820"
        WindowStartupLocation="CenterOwner"
        Background="#15171D"
        Foreground="#F9FAFB"
        Icon="/Assets/AppIcon.ico"
        ShowInTaskbar="False">
    <Grid Background="#15171D">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="16,14,16,10">
            <TextBlock Text="Log into Anthropic Console billing, then save the Console login."
                       Foreground="#D6DAE1"
                       FontSize="13"
                       FontWeight="SemiBold" />
            <TextBlock Margin="0,5,0,0"
                       Text="This reads the same prepaid API credit balance shown in Console billing. Anthropic does not document this balance endpoint, so re-saving may be needed if Console changes."
                       Foreground="#8B93A1"
                       FontSize="12"
                       TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1"
              Margin="16,0,16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Org UUID fallback"
                       Foreground="#A8AFBA"
                       FontSize="12"
                       VerticalAlignment="Center" />
            <TextBox x:Name="OrganizationUuidTextBox"
                     Grid.Column="1"
                     Height="32"
                     Margin="10,0,0,0"
                     Padding="8,4"
                     VerticalContentAlignment="Center"
                     Background="#1D2028"
                     BorderBrush="#343A46"
                     Foreground="#F9FAFB"
                     CaretBrush="#F9FAFB"
                     FontSize="12" />
            <TextBlock Grid.Column="2"
                       Margin="10,0,0,0"
                       Text="Optional. Use only if automatic organization discovery fails."
                       Foreground="#6B7280"
                       FontSize="12"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap" />
        </Grid>

        <Border Grid.Row="2"
                Margin="16,0"
                BorderBrush="#343A46"
                BorderThickness="1">
            <wv2:WebView2 x:Name="ConsoleWebView" />
        </Border>

        <Grid Grid.Row="3"
              Margin="16,12,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="StatusTextBlock"
                       Foreground="#8B93A1"
                       FontSize="12"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center" />
            <Button Grid.Column="1"
                    Width="150"
                    Height="34"
                    Margin="12,0,8,0"
                    Content="Save Login"
                    Click="SaveLoginButtonOnClick" />
            <Button Grid.Column="2"
                    Width="110"
                    Height="34"
                    Margin="0,0,8,0"
                    Content="Clear Login"
                    Click="ClearLoginButtonOnClick" />
            <Button Grid.Column="3"
                    Width="92"
                    Height="34"
                    Content="Close"
                    Click="CloseButtonOnClick" />
        </Grid>
    </Grid>
</Window>
