<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>AIUsageMonitor</AssemblyName>
    <RootNamespace>AIUsageMonitor</RootNamespace>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests\**\*.cs;tools\**\*.cs" />
    <EmbeddedResource Remove="tests\**\*;tools\**\*" />
    <None Remove="tests\**\*;tools\**\*" />
    <Page Remove="tests\**\*.xaml;tools\**\*.xaml" />

    <!--
      Disable WPF pen/tablet/touch support. WPF loads penimc_cor3.dll through a custom
      activation context that does not work with single-file self-extracting publishes,
      so re-enumerating tablet devices (on a device/settings-change window message) throws
      DllNotFoundException on the UI thread and crashes the app. This app needs no pen/touch.
    -->
    <RuntimeHostConfigurationOption Include="Switch.System.Windows.Input.Stylus.DisableStylusAndTouchSupport" Value="true" Trim="false" />

    <Resource Include="Assets\AppIcon.ico" />

    <None Update="usage.fake.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.*" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.*" />
  </ItemGroup>
</Project>
